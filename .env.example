# Copy to .env and fill in real values. This file is tracked in git;
# .env is gitignored. Docker Compose reads .env automatically for ${VAR}
# substitution in docker-compose.yml.

# --- Auth ---
# Strong random value for JWT signing (required — backend won't start without it).
JWT_SECRET=change-me-to-a-strong-random-string

# --- Postgres (db service) ---
POSTGRES_DB=simplehelp
POSTGRES_USER=simplehelp
POSTGRES_PASSWORD=simplehelp

# --- Backend DB connection (backend + test services) ---
DB_HOST=db
DB_PORT=5432
DB_USER=simplehelp
DB_PASS=simplehelp
DB_NAME=simplehelp
